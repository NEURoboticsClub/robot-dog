<launch>
  <arg name="input_cmd_vel_topic"  default="cmd_vel" />
  <arg name="output_cmd_vel_topic" default="cmd_vel/smooth_custom" />

  <node name="motion_utils_node"
        pkg="motion_utils_cpp"
        type="motion_utils_node"
        output="screen">
    <param name="input_cmd_vel_topic"  value="$(arg input_cmd_vel_topic)" />
    <param name="output_cmd_vel_topic" value="$(arg output_cmd_vel_topic)" />

    <param name="max_vx"  value="0.5" />
    <param name="max_vy"  value="0.5" />
    <param name="max_wz"  value="1.0" />
    <param name="max_ax"  value="0.5" />
    <param name="max_ay"  value="0.5" />
    <param name="max_awz" value="1.0" />
  </node>
</launch>


